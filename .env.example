DATABASE_URL=postgres://relay:relay@localhost:5544/relay
PORT=8080
# For scripts such as the smoke test. People sign in with the admin account below.
DEMO_TOKEN=relay-demo-token

# Generate with: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@relay.local
ADMIN_PASSWORD=
MOCK_WORLD_URL=http://localhost:9210
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TOKEN=relay-internal-token

# Extra hosts http_request may call, comma separated. The mock world is always allowed.
OUTBOUND_ALLOWLIST=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
LLM_STRUCTURED_OUTPUT=true
