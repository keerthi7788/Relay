{
  "name": "relay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "node src/api.js",
    "worker": "node src/worker.js",
    "test": "LOG_LEVEL=silent node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:apis": "node --test --test-concurrency=1 test/e2e/api.e2e.js",
    "lint": "eslint src test",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cron-parser": "^5.10.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
